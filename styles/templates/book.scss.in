// Generated by tools/design/identity.py from styles/templates/ and design/identity configuration.
/*-- scss:defaults --*/
$body-bg: @paper@;
$body-color: @ink@;
$primary: #126178;
$link-color: #126178;
$font-family-sans-serif: "@heading@", "Segoe UI", sans-serif;
$font-family-base: "@body@", Georgia, serif;
$headings-font-family: "@heading@", "Segoe UI", sans-serif;
$headings-color: @night@;
$font-family-monospace: "@code@", Consolas, monospace;
/*-- scss:rules --*/
body { line-height: 1.65; }
h1, h2, h3, h4, h5, h6 { font-family: $headings-font-family; }
a { text-underline-offset: .18em; }
main a:hover { text-decoration-thickness: .12em; }
.sidebar-navigation, #TOC, .quarto-title-meta, .figure-caption, .table-caption {
  font-family: $font-family-sans-serif;
}
.sidebar-title { font-weight: 700; border-bottom: 3px solid @copper@; padding-bottom: .65rem; }
.sidebar nav[role="doc-toc"] ul > li > a.active,
.sidebar-item-container .active { color: #126178; font-weight: 700; }
div.sourceCode { background: #edf1f4; border: 1px solid #ccd6dd; border-radius: .2rem; }
code { color: #204b60; }
pre code { color: inherit; }
.quarto-title-block .quarto-title .title { color: @night@; }
::selection { background: #c8eaf0; color: @ink@; }

// Editorial hierarchy and content components; retain Bootstrap responsiveness.
.page-columns > main.content { min-width: 0; }
.quarto-float-tbl > div { max-width: 100%; overflow-x: auto; }
main h1 { line-height: 1.18; margin-bottom: 1.25rem; }
main h2 { margin-top: 2rem; line-height: 1.25; }
main h3 { margin-top: 1.5rem; line-height: 1.3; }
main h4, main h5, main h6 { line-height: 1.35; }
figure.quarto-float { margin-block: 1.5rem; }
.quarto-figure img, figure img { max-width: 100%; height: auto; }
.figure-caption, .table-caption, figcaption {
  color: @ink@; font-size: .92rem; line-height: 1.45; text-align: left;
}
table { font-size: .94rem; line-height: 1.45; }
.table > thead { border-bottom: 2px solid @ink@; }
.table > :not(caption) > * > * { padding: .5rem .6rem; }
.table > tbody > tr { border-color: #ccd6dd; }
pre { line-height: 1.45; tab-size: 2; }
div.sourceCode { margin-block: 1.25rem; }
pre.sourceCode { padding: .85rem; overflow-x: auto; }
p code, li code, td code { overflow-wrap: anywhere; }
div.callout { margin-block: 1.25rem; border-color: #8b9ca8; }
div.callout .callout-title-container { font-family: $font-family-sans-serif; font-weight: 700; }
div.callout.callout-note { border-left-color: #126178; }
div.callout.callout-tip { border-left-color: #23705a; }
div.callout.callout-warning, div.callout.callout-caution { border-left-color: #8b4c12; }
div.callout.callout-important { border-left-color: #963f3f; }
.footnotes { font-size: .9rem; line-height: 1.5; border-top: 1px solid #8b9ca8; padding-top: 1rem; }
blockquote { border-left: 3px solid #8b9ca8; padding-left: 1rem; color: @ink@; }
:focus-visible { outline: 3px solid #126178; outline-offset: 3px; }
@media print {
  body { background: white; color: black; }
  .callout-collapse.collapse { display: block !important; }
  div.sourceCode { background: #f3f3f3; }
}
