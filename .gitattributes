# Keep text consistent in the repository and on Windows/Linux checkouts.
* text=auto eol=lf

# Windows command scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never undergo line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary

# Lab provenance hashes exact source and evidence bytes across platforms.
labs/** -text

# Preserve raw audit bytes, including original whitespace, for their hashes.
docs/audits/**/evidence/** -text -whitespace
